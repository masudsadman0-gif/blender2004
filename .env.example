# Autonimation Environment Variables
# Copy this file to .env and populate with your API keys

# Hugging Face Token (Required for StableGen/TRELLIS.2 PBR Generation)
# Get a free token at: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_free_token_here

# TripoSR / OpenLRM API Endpoint (If using a remote generation service)
# Example: Deploy to a free tier service like Render or Hugging Face Spaces
TRIPOSR_ENDPOINT=https://your-free-cloud-host.com/api

# Freely Hosted Cloud LLM APIs (No local PC hardware required)
# 1. Cerebras Free Tier (Fast LLM inference)
# Get a free key at: https://cloud.cerebras.ai/
CEREBRAS_API_KEY=your_free_cerebras_key_here

# 2. Together AI or Groq (Alternative free tier endpoints)
# TOGETHER_API_KEY=your_free_together_key_here
# GROQ_API_KEY=your_free_groq_key_here
